<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_bpm_enable"
        android:disableDependentsState="false"
        android:title="@string/bpm_display_title"
        android:summary="@string/bpm_display_summary"
        android:icon="@drawable/ic_baseline_sine_wave_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.DropDownPreference
            android:key="@string/key_bpm_range"
            android:title="@string/bpm_range"
            android:entries="@array/bpm_ranges"
            android:entryValues="@array/bpm_range_values"
            android:defaultValue="auto"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_bpm_size"
            android:title="@string/bpm_size"
            android:defaultValue="90"
            app:minValue="30"
            app:maxValue="100"
            app:precision="0"
            app:unit="%"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSwitchPreference
            android:key="@string/key_bpm_lcd_buttons"
            android:title="@string/bpm_lcd_buttons"
            android:summary="@string/bpm_lcd_buttons_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
