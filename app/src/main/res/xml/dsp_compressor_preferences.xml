<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_compressor_enable"
        android:disableDependentsState="false"
        android:title="@string/compressor_enable"
        android:icon="@drawable/ic_baseline_compress_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compressor_threshold"
            android:title="@string/compressor_threshold"
            android:defaultValue="-18"
            app:minValue="-60"
            app:maxValue="0"
            app:precision="1"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compressor_ratio"
            android:title="@string/compressor_ratio"
            android:defaultValue="4"
            app:minValue="1"
            app:maxValue="20"
            app:precision="1"
            app:unit=":1"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compressor_attack"
            android:title="@string/compressor_attack"
            android:defaultValue="10"
            app:minValue="0.1"
            app:maxValue="200"
            app:precision="1"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compressor_release"
            android:title="@string/compressor_release"
            android:defaultValue="150"
            app:minValue="5"
            app:maxValue="2000"
            app:precision="0"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compressor_knee"
            android:title="@string/compressor_knee"
            android:defaultValue="6"
            app:minValue="0"
            app:maxValue="24"
            app:precision="1"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compressor_makeup"
            android:title="@string/compressor_makeup"
            android:defaultValue="0"
            app:minValue="0"
            app:maxValue="24"
            app:precision="1"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
